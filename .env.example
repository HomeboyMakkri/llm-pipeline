# Обязательный ключ API
OPENAI_API_KEY=your-api-key-here

# Модель, доступная вашему API-провайдеру
LLM_MODEL=gpt-4o-mini

# Для OpenAI-совместимого провайдера можно указать адрес API.
# Для OpenAI оставьте переменную пустой или удалите строку.
LLM_BASE_URL=

# Параметры устойчивости
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
